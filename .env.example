# ===== ACE-Step API 서버 =====
ACESTEP_API_HOST=127.0.0.1
ACESTEP_API_PORT=8001
# 인증을 쓰려면 주석 해제 (빈 값으로 두면 ACE-Step이 인증을 켜버리므로 주석 상태 유지)
# ACESTEP_API_KEY=your-secret

# ===== 모델 조합 (README 권장표 기준) =====
# 6-8GB  : acestep-v15-turbo + acestep-5Hz-lm-0.6B + pt   (RTX 5060 8GB 기본값)
# 8-16GB : acestep-v15-turbo + acestep-5Hz-lm-0.6B/1.7B + vllm
# 16GB+  : 1.7B LM / XL 모델 고려
ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B
ACESTEP_LM_BACKEND=pt
ACESTEP_INIT_LLM=true
ACESTEP_OFFLOAD_TO_CPU=true
# 동시에 1곡만 생성 (GPU 1장)
ACESTEP_QUEUE_WORKERS=1

# ===== 클라이언트(테스트 스크립트/백엔드)에서 사용 =====
ACESTEP_URL=http://127.0.0.1:8001
STORAGE_DIR=./storage

# ===== 백엔드 / 워커 =====
# Redis: Docker/Linux는 실제 Redis, Redis 설치가 어려운 Windows는 scripts/dev_redis.py
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=songs
DB_PATH=./storage/musicgen.db
BLOCKLIST_PATH=./config/blocklist.txt
PROFANITY_PATH=./config/profanity.txt
# 곡 최대 길이(초): Tier3(6-8GB)+LM 기준 480
MAX_DURATION=480
JOB_TIMEOUT=1800
CORS_ORIGINS=http://localhost:3000
